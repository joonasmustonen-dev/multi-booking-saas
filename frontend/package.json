{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepare:cloudflare": "node scripts/prepareCloudflareAssets.mjs",
    "publish:cloudflare": "npm run prepare:cloudflare && wrangler deploy",
    "deploy:cloudflare": "npm run build && npm run publish:cloudflare",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:assignments": "node tests/assignmentFlows.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.0",
    "keycloak-js": "^26.2.5",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
