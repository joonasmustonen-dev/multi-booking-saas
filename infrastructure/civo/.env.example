# Public addresses; create their DNS records before starting Caddy.
API_HOST=api.example.com
AUTH_HOST=auth.example.com
FRONTEND_ORIGIN=https://bookingsaas.netlify.app

# Generate each value independently with: openssl rand -hex 32
POSTGRES_ADMIN_PASSWORD=replace_me
DATABASE_RUNTIME_PASSWORD=replace_me
DATABASE_MIGRATION_PASSWORD=replace_me
KEYCLOAK_DATABASE_PASSWORD=replace_me
KEYCLOAK_ADMIN_PASSWORD=replace_me

KEYCLOAK_ADMIN_USERNAME=booking-admin
BACKEND_AUDIENCE=booking-backend
API_REQUESTS_PER_MINUTE=240

# Put this on an attached Civo volume when available.
POSTGRES_DATA_PATH=/mnt/booking-data/postgres
